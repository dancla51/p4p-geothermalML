@article{KUBIAK2002545,
title = {Simulation of the effect of scale deposition on a geothermal turbine},
journal = {Geothermics},
volume = {31},
number = {5},
pages = {545-562},
year = {2002},
issn = {0375-6505},
doi = {https://doi.org/10.1016/S0375-6505(02)00013-5},
url = {https://www.sciencedirect.com/science/article/pii/S0375650502000135},
author = {Janusz A. Kubiak and Gustavo Urquiza-beltrán},
keywords = {Geothermal turbine, Efficiency, Steam path deterioration, Scale, Power utility},
abstract = {Dissolved chemicals contained in geothermal steam can lead to corrosion, erosion and deposition of scale on turbine blades, reducing their useful life. In addition, deposits on the blading system reduce the flow area of the turbine. The first-stage nozzle group is typically most affected by deposition of scale although scale may be present in other parts of the system. The most common deposits are of silica and calcium carbonate. This decreases the output capacity and efficiency of the turbine. This paper presents the results of simulations on the effect of scale deposition in the first-stage nozzle group on the steam pressure before and after the first stage, output capacity and efficiency of the turbine. By measuring the steam pressure before and after the first stage the change in the flow area can be estimated. A method of monitoring the percentage of nozzle plugging in real time is proposed. The method can be applied to any turbine that is susceptible to scale deposition.}
}